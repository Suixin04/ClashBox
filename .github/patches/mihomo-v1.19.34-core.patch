@@ -0,0 +1,81 @@
+//go:build (android && cmfa) || (linux && !android && ohos)
+
+package dns
+
+import (
+	"context"
+	"strings"
+	"sync"
+	"testing"
+
+	D "github.com/miekg/dns"
+)
+
+func TestInjectedSystemDNS(t *testing.T) {
+	t.Cleanup(func() { UpdateSystemDNS(nil) })
+	c := newSystemClient()
+	c.defaultNS = []dnsClient{newRCodeClient("name_error")}
+
+	UpdateSystemDNS([]string{"192.0.2.1:53", "", " [2001:db8::1]:5353 "})
+	if got, want := c.Address(), "system(udp://192.0.2.1:53,udp://[2001:db8::1]:5353)"; got != want {
+		t.Fatalf("Address() = %q, want %q", got, want)
+	}
+	snapshot, err := c.getDnsClients()
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	UpdateSystemDNS([]string{"192.0.2.2:53"})
+	if got, want := c.Address(), "system(udp://192.0.2.2:53)"; got != want {
+		t.Fatalf("Address() = %q after replacement, want %q", got, want)
+	}
+	if got, want := snapshot[0].Address(), "udp://192.0.2.1:53"; got != want {
+		t.Fatalf("prior snapshot changed: %q, want %q", got, want)
+	}
+
+	for _, addr := range [][]string{nil, {}, strings.Split("", ","), {" ", ""}} {
+		UpdateSystemDNS([]string{"192.0.2.1:53"})
+		UpdateSystemDNS(addr)
+		if clients, err := c.getDnsClients(); clients != nil || err != nil {
+			t.Fatalf("getDnsClients() after UpdateSystemDNS(%#v) = %v, %v; want nil, nil", addr, clients, err)
+		}
+		if got, want := c.Address(), "system[defaultNS](rcode://name_error)"; got != want {
+			t.Fatalf("Address() = %q after clearing, want %q", got, want)
+		}
+		query := new(D.Msg).SetQuestion("example.test.", D.TypeA)
+		reply, err := c.ExchangeContext(context.Background(), query)
+		if err != nil || reply == nil || reply.Rcode != D.RcodeNameError {
+			t.Fatalf("ExchangeContext() did not use defaultNS: %v, %v", reply, err)
+		}
+	}
+}
+
+func TestInjectedSystemDNSConcurrent(t *testing.T) {
+	t.Cleanup(func() { UpdateSystemDNS(nil) })
+	c := newSystemClient()
+	var wg sync.WaitGroup
+	start := make(chan struct{})
+	for _, work := range []func(){
+		func() { UpdateSystemDNS([]string{"192.0.2.1:53", "[2001:db8::1]:53"}) },
+		func() { UpdateSystemDNS(nil) },
+		func() {
+			switch got := c.Address(); got {
+			case "system()", "system(udp://192.0.2.1:53,udp://[2001:db8::1]:53)":
+			default:
+				t.Errorf("Address() returned an unexpected snapshot: %q", got)
+			}
+		},
+		c.ResetConnection,
+	} {
+		wg.Add(1)
+		go func(work func()) {
+			defer wg.Done()
+			<-start
+			for i := 0; i < 100; i++ {
+				work()
+			}
+		}(work)
+	}
+	close(start)
+	wg.Wait()
+}
