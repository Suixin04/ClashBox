+
+func TestTrafficViews(t *testing.T) {
+	m := new(Manager)
+	check := func(name string, read func() (int64, int64), wantUp, wantDown int64) {
+		t.Helper()
+		if up, down := read(); up != wantUp || down != wantDown {
+			t.Errorf("%s = (%d, %d), want (%d, %d)", name, up, down, wantUp, wantDown)
+		}
+	}
+	nowAll := func() (int64, int64) { return m.NowTraffic(false) }
+	nowProxy := func() (int64, int64) { return m.NowTraffic(true) }
+	totalAll := func() (int64, int64) { return m.TotalTraffic(false) }
+	totalProxy := func() (int64, int64) { return m.TotalTraffic(true) }
+
+	m.pushUploaded("DIRECT", 5)
+	m.pushDownloaded("DIRECT", 7)
+	m.pushUploaded("proxy", 11)
+	m.pushDownloaded("proxy", 13)
+	m.PushUploaded(17)
+	m.PushDownloaded(19)
+
+	check("Now before tick", m.Now, 0, 0)
+	check("proxy Now before tick", nowProxy, 0, 0)
+	check("Total", m.Total, 33, 39)
+	check("all traffic total", totalAll, 33, 39)
+	check("proxy traffic total", totalProxy, 28, 32)
+	if s := m.Snapshot(); s.UploadTotal != 33 || s.DownloadTotal != 39 {
+		t.Errorf("Snapshot totals = (%d, %d), want (33, 39)", s.UploadTotal, s.DownloadTotal)
+	}
+
+	m.updateBlips()
+	check("Now after tick", m.Now, 33, 39)
+	check("all traffic now", nowAll, 33, 39)
+	check("proxy traffic now", nowProxy, 28, 32)
+	m.updateBlips()
+	check("all traffic now in idle window", nowAll, 0, 0)
+	check("proxy traffic now in idle window", nowProxy, 0, 0)
+	check("all traffic total after idle window", totalAll, 33, 39)
+	check("proxy traffic total after idle window", totalProxy, 28, 32)
+
+	m.pushUploaded("proxy", 23)
+	m.pushDownloaded("proxy", 29)
+	m.updateBlips()
+	m.pushUploaded("proxy", 31)
+	m.pushDownloaded("proxy", 37)
+	m.ResetStatistic()
+	check("all traffic now after reset", nowAll, 0, 0)
+	check("proxy traffic now after reset", nowProxy, 0, 0)
+	check("all traffic total after reset", totalAll, 0, 0)
+	check("proxy traffic total after reset", totalProxy, 0, 0)
+	m.updateBlips()
+	check("all traffic now at first tick after reset", nowAll, 0, 0)
+	check("proxy traffic now at first tick after reset", nowProxy, 0, 0)
