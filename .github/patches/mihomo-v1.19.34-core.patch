+
+func TestTrackerTrafficAccounting(t *testing.T) {
+	for _, tc := range []struct {
+		name     string
+		chain    C.Chain
+		push     bool
+		proxied  bool
+	}{
+		{"direct through group", C.Chain{"DIRECT", "group"}, true, false},
+		{"proxy through group", C.Chain{"node", "DIRECT"}, true, true},
+		{"empty chain", nil, true, true},
+		{"manager accounting disabled", C.Chain{"node"}, false, false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			m := new(Manager)
+			tcp := NewTCPTracker(&trafficTCPConn{chain: tc.chain}, m, &C.Metadata{}, nil, 2, 3, tc.push)
+			udp := NewUDPTracker(&trafficUDPConn{chain: tc.chain}, m, &C.Metadata{}, nil, 5, 7, tc.push)
+			check := func(name string, up, down, wantUp, wantDown int64) {
+				t.Helper()
+				if up != wantUp || down != wantDown {
+					t.Errorf("%s = (%d, %d), want (%d, %d)", name, up, down, wantUp, wantDown)
+				}
+			}
+			checkPath := func(name string, wantUp, wantDown int64) {
+				t.Helper()
+				var allUp, allDown, proxyUp, proxyDown int64
+				if tc.push {
+					allUp, allDown = wantUp, wantDown
+				}
+				if tc.proxied {
+					proxyUp, proxyDown = wantUp, wantDown
+				}
+				up, down := m.Total()
+				check(name+" all", up, down, allUp, allDown)
+				up, down = m.TotalTraffic(true)
+				check(name+" proxy", up, down, proxyUp, proxyDown)
+				m.ResetStatistic()
+			}
+			checkPath("initial bytes", 7, 10)
+
+			_, _ = tcp.Write(make([]byte, 11))
+			_, _ = tcp.Read(make([]byte, 13))
+			checkPath("TCP read/write", 11, 13)
+
+			_ = tcp.WriteBuffer(buf.As(make([]byte, 17)))
+			buffer := buf.NewSize(19)
+			defer buffer.Release()
+			if err := tcp.ReadBuffer(buffer); err != nil {
+				t.Fatal(err)
+			}
+			checkPath("TCP buffers", 17, 19)
+
+			_, writeCounts := tcp.UnwrapWriter()
+			_, readCounts := tcp.UnwrapReader()
+			writeCounts[0](23)
+			readCounts[0](29)
+			checkPath("TCP unwrap", 23, 29)
+
+			_, _ = udp.WriteTo(make([]byte, 31), nil)
+			_, _, _ = udp.ReadFrom(make([]byte, 37))
+			_, _, _, _ = udp.WaitReadFrom()
+			checkPath("UDP read/write/wait", 31, 78)
+
+			check("TCP connection totals", tcp.UploadTotal.Load(), tcp.DownloadTotal.Load(), 53, 64)
+			check("UDP connection totals", udp.UploadTotal.Load(), udp.DownloadTotal.Load(), 36, 85)
+		})
+	}
+}
+
+type trafficTCPConn struct {
+	C.Conn
+	chain C.Chain
+}
+
+func (c *trafficTCPConn) Chains() C.Chain                { return c.chain }
+func (*trafficTCPConn) ProviderChains() C.Chain          { return nil }
+func (*trafficTCPConn) RemoteDestination() string        { return "" }
+func (*trafficTCPConn) Read(p []byte) (int, error)        { return len(p), nil }
+func (*trafficTCPConn) Write(p []byte) (int, error)       { return len(p), nil }
+func (*trafficTCPConn) ReadBuffer(b *buf.Buffer) error    { _, err := b.Write(make([]byte, 19)); return err }
+func (*trafficTCPConn) WriteBuffer(b *buf.Buffer) error   { b.Release(); return nil }
