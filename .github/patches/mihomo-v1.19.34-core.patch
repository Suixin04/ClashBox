+func (*trafficUDPConn) WriteTo(p []byte, _ net.Addr) (int, error) {
+	return len(p), nil
+}
+func (*trafficUDPConn) WaitReadFrom() ([]byte, func(), net.Addr, error) {
+	return make([]byte, 41), nil, nil, nil
