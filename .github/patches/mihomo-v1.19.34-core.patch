diff --git a/component/iface/iface_injected_linux.go b/component/iface/iface_injected_linux.go
new file mode 100644
--- /dev/null
+++ b/component/iface/iface_injected_linux.go
@@ -0,0 +1,96 @@
+//go:build linux && ohos
+
+package iface
+
+import (
+	"net"
+	"net/netip"
+	"sync/atomic"
+)
+
+type interfaceSnapshot struct {
+	interfaces []*Interface
+	byName     map[string]*Interface
+}
+
+var systemSnapshot atomic.Pointer[interfaceSnapshot]
+
+func init() {
+	loadInterfaces = loadOHOSInterfaces
+}
+
+// SetNetInterfaces 注入系统接口及其本机地址快照；空列表清除快照。
+func SetNetInterfaces(interfaces []Interface) {
+	snapshot := &interfaceSnapshot{byName: make(map[string]*Interface, len(interfaces))}
+	for _, ifi := range interfaces {
+		if ifi.Name == "" || ifi.Index <= 0 || snapshot.byName[ifi.Name] != nil {
+			continue
+		}
+		copyOfInterface := ifi
+		copyOfInterface.HardwareAddr = append(net.HardwareAddr(nil), ifi.HardwareAddr...)
+		copyOfInterface.Addresses = nil
+		for _, prefix := range ifi.Addresses {
+			if prefix.IsValid() {
+				copyOfInterface.Addresses = append(copyOfInterface.Addresses, prefix)
+			}
+		}
+		snapshot.interfaces = append(snapshot.interfaces, &copyOfInterface)
+		snapshot.byName[ifi.Name] = &copyOfInterface
+	}
+	systemSnapshot.Store(snapshot)
+	FlushCache()
+}
+
+// SetNetInterfacesByName 仅用接口名查找系统接口，不把邻居地址当作本机地址。
+func SetNetInterfacesByName(names []string) error {
+	interfaces := make([]Interface, 0, len(names))
+	seen := make(map[string]bool, len(names))
+	var lookupErr error
+	for _, name := range names {
+		if name == "" || seen[name] {
+			continue
+		}
+		seen[name] = true
+		ifi, err := net.InterfaceByName(name)
+		if err != nil {
+			lookupErr = err
+			continue
+		}
+		// 即使地址不可读，也保留真实接口，以便按名称或索引查找。
+		systemInterface, _ := readInterface(ifi)
+		interfaces = append(interfaces, *systemInterface)
+	}
+	if len(names) != 0 && len(interfaces) == 0 {
+		if lookupErr != nil {
+			return lookupErr
+		}
+		return ErrIfaceNotFound
+	}
+	SetNetInterfaces(interfaces)
+	return nil
+}
+
+func loadOHOSInterfaces() ([]*Interface, error) {
+	snapshot := systemSnapshot.Load()
+	interfaces, err := readSystemInterfaces(func(ifi *Interface) {
+		if snapshot == nil {
+			return
+		}
+		if cached := snapshot.byName[ifi.Name]; cached != nil && cached.Index == ifi.Index {
+			ifi.Addresses = append([]netip.Prefix(nil), cached.Addresses...)
+		}
+	})
+	// 默认网卡检测依赖实时接口列表，不能用不完整的邻居表快照覆盖它。
+	if len(interfaces) != 0 || snapshot == nil || len(snapshot.interfaces) == 0 {
+		return interfaces, err
+	}
+
+	interfaces = make([]*Interface, 0, len(snapshot.interfaces))
+	for _, cached := range snapshot.interfaces {
+		ifi := *cached
+		ifi.HardwareAddr = append(net.HardwareAddr(nil), cached.HardwareAddr...)
+		ifi.Addresses = append([]netip.Prefix(nil), cached.Addresses...)
+		interfaces = append(interfaces, &ifi)
+	}
+	return interfaces, nil
+}
