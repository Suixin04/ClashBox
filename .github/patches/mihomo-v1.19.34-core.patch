+// geoUpdatePath 返回经校验的写入路径，以及它是否指向核心当前使用的默认库。
+func geoUpdatePath(path, defaultPath string) (string, bool, error) {
+	if path == "" {
+		if defaultPath == "" {
+			return "", false, errors.New("GEO database default path is unavailable")
+		}
+		return defaultPath, true, nil
+	}
+	path, err := filepath.Abs(C.Path.Resolve(path))
+	if err != nil {
+		return "", false, err
+	}
+	if !C.Path.IsSafePath(path) {
+		return "", false, C.Path.ErrNotSafePath(path)
+	}
+	resolved, err := resolveGeoUpdatePath(path)
+	if err != nil {
+		return "", false, err
+	}
+	if resolved != path && !isSafeResolvedGeoPath(path, resolved) {
+		return "", false, C.Path.ErrNotSafePath(path)
+	}
+
+	info, err := os.Stat(resolved)
+	if err != nil && !os.IsNotExist(err) {
+		return "", false, err
+	}
+	if home, _ := filepath.Abs(C.Path.HomeDir()); path == home || (info != nil && !info.Mode().IsRegular()) {
+		return "", false, fmt.Errorf("GEO database destination is not a regular file: %s", path)
+	}
+	return resolved, isDefaultGeoPath(resolved, defaultPath, info), nil
+}
+
+func resolveGeoUpdatePath(path string) (string, error) {
+	// 新文件可能尚不存在，沿父目录查找已存在的部分，再拼回未创建的路径。
+	for probe := path; ; probe = filepath.Dir(probe) {
+		if _, err := os.Lstat(probe); err != nil {
+			if os.IsNotExist(err) && probe != filepath.Dir(probe) {
+				continue
+			}
+			return "", err
+		}
+		resolved, err := filepath.EvalSymlinks(probe)
+		if err != nil {
+			return "", err
+		}
+		rel, err := filepath.Rel(probe, path)
+		if err != nil {
+			return "", err
+		}
+		return filepath.Join(resolved, rel), nil
+	}
+}
+
+func isSafeResolvedGeoPath(path, resolved string) bool {
+	if C.Path.IsSafePath(resolved) {
+		return true
+	}
+	// 允许目录本身可能是符号链接；解析后的路径仍须位于同一允许目录内。
+	for _, root := range C.Path.SafePaths() {
+		if rel, err := filepath.Rel(root, path); err != nil || !filepath.IsLocal(rel) {
+			continue
+		}
+		if realRoot, err := filepath.EvalSymlinks(root); err == nil {
+			if rel, err := filepath.Rel(realRoot, resolved); err == nil && filepath.IsLocal(rel) {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+func isDefaultGeoPath(path, defaultPath string, info os.FileInfo) bool {
+	if defaultPath == "" {
+		return false
+	}
+	abs, err := filepath.Abs(defaultPath)
+	if err == nil {
+		if path == abs {
+			return true
+		}
+		if resolved, err := resolveGeoUpdatePath(abs); err == nil && path == resolved {
+			return true
+		}
+	}
+	defaultInfo, err := os.Stat(defaultPath)
+	return err == nil && info != nil && os.SameFile(info, defaultInfo)
+}
+
+func UpdateMMDB() error {
+	return UpdateMMDBWithPath("")
+}
+
+func UpdateMMDBWithPath(path string) (err error) {
+	defaultPath := C.Path.MMDB()
+	path, active, err := geoUpdatePath(path, defaultPath)
+	if err != nil {
+		return err
+	}
+	vehicle := resource.NewHTTPVehicle(geodata.MmdbUrl(), path, "", nil, defaultHttpTimeout, 0)
 	var oldHash utils.HashType
 	if buf, err := os.ReadFile(vehicle.Path()); err == nil {
 		oldHash = utils.MakeHash(buf)
@@ -67,16 +166,30 @@
