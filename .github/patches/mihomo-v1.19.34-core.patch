+func readInterface(ifi *net.Interface) (*Interface, error) {
+	result := &Interface{
+		Index:        ifi.Index,
+		MTU:          ifi.MTU,
+		Name:         ifi.Name,
+		HardwareAddr: ifi.HardwareAddr,
+		Flags:        ifi.Flags,
+	}
+	addrs, err := anet.InterfaceAddrsByInterface(ifi)
+	if err != nil {
+		return result, err
+	}
+
+	result.Addresses = make([]netip.Prefix, 0, len(addrs))
+	for _, addr := range addrs {
+		var prefix netip.Prefix
+		switch ipNet := addr.(type) {
+		case *net.IPNet:
+			ip, _ := netip.AddrFromSlice(ipNet.IP)
+			ones, bits := ipNet.Mask.Size()
+			if bits == 32 {
+				ip = ip.Unmap()
+			}
+			prefix = netip.PrefixFrom(ip, ones)
+		case *net.IPAddr:
+			ip, _ := netip.AddrFromSlice(ipNet.IP)
+			ip = ip.Unmap()
+			prefix = netip.PrefixFrom(ip, ip.BitLen())
+		}
+		if prefix.IsValid() {
+			result.Addresses = append(result.Addresses, prefix)
+		}
+	}
+	return result, nil
+}
+
