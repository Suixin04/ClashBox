+	result := make([]*Interface, 0, len(ifaces))
+	for i := range ifaces {
+		ifi, err := readInterface(&ifaces[i])
+		if err != nil {
+			if onAddrError == nil {
+				continue
+			}
+			onAddrError(ifi)
+		}
+		result = append(result, ifi)
+	}
+	return result, nil
+}
