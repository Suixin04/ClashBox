new file mode 100644
--- /dev/null
+++ b/dns/system_injected.go
@@ -0,0 +1,54 @@
+//go:build (android && cmfa) || (linux && !android && ohos)
+
+package dns
+
+import (
+	"strings"
+	"sync"
+
+	"github.com/metacubex/mihomo/component/resolver"
+)
+
+var injectedSystemDNS struct {
+	sync.RWMutex
+	clients []dnsClient
+}
+
+func FlushCacheWithDefaultResolver() {
+	resolver.ClearCache()
+	resolver.ResetConnection()
+}
+
+// UpdateSystemDNS 用给定的 host:port 地址替换注入的 UDP DNS 服务器。
+func UpdateSystemDNS(addr []string) {
+	ns := make([]NameServer, 0, len(addr))
+	for _, d := range addr {
+		// 桥接层拆分空字符串后会得到一个空条目。
+		if d = strings.TrimSpace(d); d != "" {
+			ns = append(ns, NameServer{Addr: d})
+		}
+	}
+
+	var clients []dnsClient
+	if len(ns) > 0 {
+		clients = transform(ns, nil)
+	}
+
+	injectedSystemDNS.Lock()
+	injectedSystemDNS.clients = clients
+	injectedSystemDNS.Unlock()
+}
+
+func (c *systemClient) getDnsClients() ([]dnsClient, error) {
+	injectedSystemDNS.RLock()
+	defer injectedSystemDNS.RUnlock()
+	// 更新只替换切片，不修改已发布的快照。
+	return injectedSystemDNS.clients, nil
+}
+
+func (c *systemClient) ResetConnection() {
+	clients, _ := c.getDnsClients()
+	for _, r := range clients {
+		r.ResetConnection()
+	}
+}
